<div class="staff-comments-list"></div>
<div class="form-group" style="margin-bottom: 8px">
    <textarea class="form-control" name="staffComment" rows="3" maxlength="2000" placeholder="{{translate 'Write a comment' category='labels' scope='User'}}"></textarea>
</div>
<button type="button" class="btn btn-primary btn-sm" data-action="addComment">
    {{translate 'Add Comment' category='labels' scope='User'}}
</button>
<span class="staff-comment-status text-danger" style="margin-left: 8px"></span>
