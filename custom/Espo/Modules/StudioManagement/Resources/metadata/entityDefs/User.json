{
  "fields": {
    "smAccountType": {
      "type": "enum",
      "options": [
        "",
        "Model",
        "Operator",
        "ProducerAdmin",
        "TechnicalDirector",
        "Recruiter"
      ],
      "default": "",
      "audited": true,
      "displayAsLabel": true,
      "style": {
        "Model": "primary",
        "Operator": "info",
        "ProducerAdmin": "warning",
        "TechnicalDirector": "danger",
        "Recruiter": "success"
      }
    },
    "smSharePercentOverride": {
      "type": "decimal",
      "precision": 7,
      "scale": 4,
      "decimalPlaces": 4,
      "min": 0,
      "max": 100,
      "audited": true,
      "tooltip": true
    },
    "smOperatorSharePercentOverride": {
      "type": "decimal",
      "precision": 7,
      "scale": 4,
      "decimalPlaces": 4,
      "min": 0,
      "max": 100,
      "audited": true,
      "tooltip": true
    },
    "smProducerSharePercentOverride": {
      "type": "decimal",
      "precision": 7,
      "scale": 4,
      "decimalPlaces": 4,
      "min": 0,
      "max": 100,
      "audited": true,
      "tooltip": true
    },
    "smTechnicalDirectorSharePercentOverride": {
      "type": "decimal",
      "precision": 7,
      "scale": 4,
      "decimalPlaces": 4,
      "min": 0,
      "max": 100,
      "audited": true,
      "tooltip": true
    },
    "smRecruiter": {
      "type": "link",
      "audited": true,
      "selectFilterType": "primary",
      "selectPrimaryFilterName": "smRecruiters"
    },
    "smRecruits": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smRecruiterRewardMode": {
      "type": "enum",
      "options": [
        "None",
        "FlatAfterFiveShifts",
        "PercentPerShift"
      ],
      "default": "None",
      "audited": true,
      "displayAsLabel": true,
      "style": {
        "None": "default",
        "FlatAfterFiveShifts": "warning",
        "PercentPerShift": "success"
      }
    },
    "smRecruiterPercent": {
      "type": "decimal",
      "precision": 7,
      "scale": 4,
      "decimalPlaces": 4,
      "min": 0,
      "max": 100,
      "default": 5,
      "audited": true
    },
    "smRecruiterFlatAmount": {
      "type": "decimal",
      "precision": 18,
      "scale": 2,
      "decimalPlaces": 2,
      "min": 0,
      "default": 150,
      "audited": true
    },
    "smRecruiterMilestonePaid": {
      "type": "bool",
      "default": false,
      "readOnly": true,
      "audited": true
    },
    "smBirthDate": {
      "type": "date",
      "audited": true
    },
    "smStartDate": {
      "type": "date",
      "audited": true
    },
    "smContact": {
      "type": "varchar",
      "maxLength": 255,
      "audited": true
    },
    "smProfileBio": {
      "type": "text",
      "audited": true
    },
    "smSiteAccess": {
      "type": "text",
      "audited": true
    },
    "smSiteData": {
      "type": "jsonArray",
      "view": "studio-management:views/sm-shift/fields/site-data",
      "audited": false
    },
    "smProfilePhotos": {
      "type": "attachmentMultiple",
      "sourceList": [
        "Document"
      ],
      "accept": [
        "image/*"
      ],
      "maxCount": 50
    },
    "smDocumentPhotos": {
      "type": "attachmentMultiple",
      "sourceList": [
        "Document"
      ],
      "accept": [
        "image/*",
        "application/pdf"
      ],
      "maxCount": 50
    },
    "smProfileComments": {
      "type": "jsonArray",
      "readOnly": true
    },
    "smDelegatedUserName": {
      "type": "varchar",
      "notStorable": true,
      "maxLength": 50
    },
    "smCommentsWidget": {
      "type": "varchar",
      "notStorable": true,
      "readOnly": true,
      "view": "studio-management:views/user/fields/staff-comments"
    },
    "smProfileDashboard": {
      "type": "varchar",
      "notStorable": true,
      "readOnly": true,
      "view": "studio-management:views/user/fields/staff-dashboard"
    },
    "smShifts": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smOperatorShifts": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smModelShifts": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smClosedShifts": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smProducerTeams": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smProducerFinancialSnapshots": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smRecruiterRegistrationLinks": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smShiftExpenses": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smOperatorTeams": {
      "type": "linkMultiple",
      "readOnly": true
    },
    "smModelTeams": {
      "type": "linkMultiple",
      "readOnly": true
    }
  },
  "links": {
    "smShifts": {
      "type": "hasMany",
      "entity": "SmShift",
      "foreign": "participants",
      "relationName": "SmShiftUser"
    },
    "smOperatorShifts": {
      "type": "hasMany",
      "entity": "SmShift",
      "foreign": "operator"
    },
    "smModelShifts": {
      "type": "hasMany",
      "entity": "SmShift",
      "foreign": "model"
    },
    "smClosedShifts": {
      "type": "hasMany",
      "entity": "SmShift",
      "foreign": "closedBy"
    },
    "smProducerTeams": {
      "type": "hasMany",
      "entity": "Team",
      "foreign": "smProducer"
    },
    "smProducerFinancialSnapshots": {
      "type": "hasMany",
      "entity": "SmShiftFinancialSnapshot",
      "foreign": "producer"
    },
    "smRecruiter": {
      "type": "belongsTo",
      "entity": "User",
      "foreign": "smRecruits"
    },
    "smRecruits": {
      "type": "hasMany",
      "entity": "User",
      "foreign": "smRecruiter"
    },
    "smRecruiterRegistrationLinks": {
      "type": "hasMany",
      "entity": "SmRegistrationLink",
      "foreign": "recruiter"
    },
    "smShiftExpenses": {
      "type": "hasMany",
      "entity": "SmShiftExpense",
      "foreign": "user"
    },
    "smOperatorTeams": {
      "type": "hasMany",
      "entity": "Team",
      "foreign": "smOperator"
    },
    "smModelTeams": {
      "type": "hasMany",
      "entity": "Team",
      "foreign": "smModel"
    },
    "smProducedShifts": {
      "type": "hasMany",
      "entity": "SmShift",
      "foreign": "producer"
    }
  }
}
