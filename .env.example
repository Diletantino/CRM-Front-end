ESPOCRM_VERSION=10.0.10

CRM_BIND_ADDRESS=127.0.0.1
CRM_HTTP_PORT=8080
CRM_WEBSOCKET_PORT=8081
CRM_SITE_URL=http://localhost:8080
CRM_WEBSOCKET_URL=ws://localhost:8081
CRM_LANGUAGE=ru_RU
CRM_TIME_ZONE=Europe/Berlin
CRM_DEFAULT_CURRENCY=USD
# Use false for live local template editing; keep true on the server.
CRM_USE_CACHE=true

# Local development defaults. Use .env.production.example on the server.
CRM_ADMIN_HOSTS=localhost,127.0.0.1
CRM_ADMIN_ALLOWED_IPS=127.0.0.1,::1,172.16.0.0/12

# Keep REMOTE_ADDR unless a trusted reverse proxy supplies the client address.
# With a correctly configured proxy this can be HTTP_X_REAL_IP.
CRM_IP_ADDRESS_SERVER_PARAM=REMOTE_ADDR

# Session and password policy (hours for token lifetime/idle time).
CRM_AUTH_TOKEN_LIFETIME=24
CRM_AUTH_TOKEN_MAX_IDLE_TIME=8
CRM_PASSWORD_MIN_LENGTH=10
CRM_PASSWORD_MIN_LETTERS=1
CRM_PASSWORD_MIN_NUMBERS=1
CRM_PASSWORD_BOTH_CASES=true
CRM_ADMIN_PASSWORD_RECOVERY_DISABLED=true
CRM_ADMIN_UPGRADE_DISABLED=true

CRM_ADMIN_USERNAME=admin
CRM_ADMIN_PASSWORD=change-this-admin-password

MARIADB_DATABASE=espocrm
MARIADB_USER=espocrm
MARIADB_PASSWORD=change-this-database-password
MARIADB_ROOT_PASSWORD=change-this-root-password
